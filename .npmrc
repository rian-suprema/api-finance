# Segurança de supply chain no ambiente LOCAL.
# CI e Docker já passam --ignore-scripts explícito; este arquivo estende a
# MESMA proteção a `npm install`/`npm ci` locais: bloqueia scripts de
# pós-install de terceiros (o vetor nº 1 do ecossistema npm).
ignore-scripts=true

# Nova dependência entra com versão EXATA (sem ^) — atualização é decisão
# consciente, revisada em PR (o Dependabot cuida dos bumps).
save-exact=true

# NOTA: com ignore-scripts, o script "prepare" (husky) NÃO roda no install.
# Após o primeiro `npm ci`, rode UMA vez `npm run prepare` para ativar os
# git hooks (pre-commit lint/format e commit-msg).
