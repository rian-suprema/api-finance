# Ambiente do serviço `api` no docker-compose (--profile full).
# Hostnames são os nomes dos serviços na rede do compose.
NODE_ENV=development
PORT=3005
API_PREFIX=api/v1
HTTP_REQUEST_TIMEOUT_MS=30000
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=users
DB_PASSWORD=users
DB_NAME=users
DB_SSL=false

# Auth SayPlus — a chave PÚBLICA de DEV é montada como volume no compose
# (./keys → /etc/sayplus/jwt). Rode `npm run auth:keys` no host ANTES de subir
# o profile full, senão a app sobe fail-closed (rotas protegidas → 401).
JWT_PUBLIC_KEY_PATH=/etc/sayplus/jwt/public.pem
JWT_ISSUER=sayplus
JWT_AUDIENCE=petshop

# Finance — as 3 integrações externas (Fases 05/06/08) rodam como stubs no
# HOST (`node scripts/finance-dev-stubs.js`, portas 3100/8123/9001), fora da
# rede do compose — `host.docker.internal` (já resolvido pelo Docker Desktop/
# WSL2 nesta máquina, sem `extra_hosts` extra) é como o container `api`
# alcança o host. Em produção estas 3 URLs vêm do ConfigMap/Secret via
# `envFrom` do Helm (deploy/helm/users-api/templates/deployment.yaml),
# nunca daqui — este arquivo é só para `docker compose --profile full up`.
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_DATABASE=dw_bet
TRIO_BASE_URL=http://host.docker.internal:9001
TRIO_CLIENT_ID=dev
TRIO_CLIENT_SECRET=dev
TRIO_AMOUNT_DIVISOR=100
TRIO_ACCOUNT_ID_SUPREMA=acc-suprema
TRIO_ACCOUNT_ID_ULTRA=acc-ultra
TRIO_ACCOUNT_ID_MAXIMA=acc-maxima
SAYPLUS_API_URL=http://host.docker.internal:3100
RECONCILIATION_BANK_KEY_FIELD=external_id
