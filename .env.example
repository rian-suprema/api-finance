# ==============================================================================
# users-api — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o `.env` real (está no .gitignore).
# Todas as variáveis são validadas no boot por schema Joi (src/config/env.validation.ts):
# variável obrigatória ausente = aplicação não sobe (fail-fast).
# ==============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3005
# Prefixo da API de negócio (default do archetype: api/v1)
API_PREFIX=api/v1
# Timeout global de requisições HTTP de entrada (interceptor), em ms
HTTP_REQUEST_TIMEOUT_MS=30000
# Nível dos logs estruturados (pino): fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Pretty-print legível no terminal — SÓ no host de dev (a imagem não tem pino-pretty)
LOG_PRETTY=true

# --- Observabilidade (OpenTelemetry) — OPCIONAL, desligada por padrão ---------
# Sem OTEL_EXPORTER_OTLP_ENDPOINT o SDK nem inicia (interruptor fail-safe).
# Para ver traces/métricas/logs localmente:
#   docker compose --profile observability up -d   (Grafana em localhost:3300)
#   e descomente:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=users-api

# --- Auth SayPlus (JWT RS256 — validação passiva) ------------------------------
# O módulo NÃO emite tokens: só valida, com a chave PÚBLICA da plataforma.
# Sem a chave o app SOBE, probes passam, e toda rota protegida responde 401
# (fail-closed — decisão registrada). Para desenvolvimento local:
#   npm run auth:keys     # gera keys/{private,public}.pem (gitignorado)
#   npm run auth:token    # imprime um Bearer token de dev com as permissões do módulo
# Produção: a chave pública REAL da SayPlus é montada via Secret (ver Helm).
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=sayplus
JWT_AUDIENCE=petshop

# --- Banco de dados (RDS Aurora PostgreSQL) -----------------------------------
# Local: container `postgres` do docker-compose.
# AWS: use o endpoint do cluster Aurora (writer) e DB_SSL=true.
# Produção: injete credenciais via AWS Secrets Manager / task definition — não via .env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=users
DB_PASSWORD=users
DB_NAME=users
DB_SSL=false

# --- Separação de papéis da RLS (Step 5) — OPCIONAL ---------------------------
# Sem estas vars, migrations e app usam o mesmo DB_USERNAME (fluxo simples de
# dev; como é superusuário local, a RLS fica inerte — cômodo para desenvolver).
# Para EXERCITAR a RLS de verdade localmente (os roles são criados pelo
# scripts/initdb/01-roles.sql na 1ª subida do Postgres):
#   DB_MIGRATION_USERNAME=users_owner  → roda migrations (owner, não-super)
#   DB_MIGRATION_PASSWORD=users_owner_dev
#   DB_APP_ROLE=users_app              → a migration concede os grants a ele
#   e rode a APP com DB_USERNAME=users_app / DB_PASSWORD=users_app_dev
# DB_MIGRATION_USERNAME=users_owner
# DB_MIGRATION_PASSWORD=users_owner_dev
# DB_APP_ROLE=users_app

# --- Finance — ClickHouse (read-model, marts dw_bet.*) ------------------------
# Local: node scripts/finance-dev-stubs.js (porta :8123).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_DATABASE=dw_bet

# --- Finance — Trio (banking-api) ---------------------------------------------
# Local: node scripts/finance-dev-stubs.js (porta :9001).
TRIO_BASE_URL=http://localhost:9001
TRIO_CLIENT_ID=dev
TRIO_CLIENT_SECRET=dev
# 1 (reais) ou 100 (centavos) — NUNCA adivinhar. Confirmar contra a doc da Trio
# antes de preencher em ambiente real (PARADA HUMANA da Fase 06).
TRIO_AMOUNT_DIVISOR=1
TRIO_ACCOUNT_ID_SUPREMA=acc-suprema
TRIO_ACCOUNT_ID_ULTRA=acc-ultra
TRIO_ACCOUNT_ID_MAXIMA=acc-maxima

# --- Finance — Identidade da plataforma SayPlus (GET /auth/me) ---------------
# Local: node scripts/finance-dev-stubs.js (porta :3100).
SAYPLUS_API_URL=http://localhost:3100

# --- Finance — Conciliação ------------------------------------------------------
# Campo do extrato bancário usado como chave de casamento com a plataforma.
RECONCILIATION_BANK_KEY_FIELD=external_id
