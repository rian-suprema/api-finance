# ==============================================================================
# users-api — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o `.env` real (está no .gitignore).
# Todas as variáveis são validadas no boot por schema Joi (src/config/env.validation.ts):
# variável obrigatória ausente = aplicação não sobe (fail-fast).
# ==============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Prefixo da API de negócio (default do archetype: api/v1)
API_PREFIX=api/v1
# Timeout global de requisições HTTP de entrada (interceptor), em ms
HTTP_REQUEST_TIMEOUT_MS=30000
# Nível dos logs estruturados (pino): fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Pretty-print legível no terminal — SÓ no host de dev (a imagem não tem pino-pretty)
LOG_PRETTY=true

# --- Observabilidade (OpenTelemetry) — OPCIONAL, desligada por padrão ---------
# Sem OTEL_EXPORTER_OTLP_ENDPOINT o SDK nem inicia (interruptor fail-safe).
# Para ver traces/métricas/logs localmente:
#   docker compose --profile observability up -d   (Grafana em localhost:3300)
#   e descomente:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=users-api

# --- Banco de dados (RDS Aurora PostgreSQL) -----------------------------------
# Local: container `postgres` do docker-compose.
# AWS: use o endpoint do cluster Aurora (writer) e DB_SSL=true.
# Produção: injete credenciais via AWS Secrets Manager / task definition — não via .env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=users
DB_PASSWORD=users
DB_NAME=users
DB_SSL=false
