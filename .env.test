# Ambiente de testes unitários (os e2e recebem env dos Testcontainers em runtime).
# Sem credencial real: valores inertes apenas para satisfazer a validação de config.
NODE_ENV=test
API_PREFIX=api/v1
PORT=3001
HTTP_REQUEST_TIMEOUT_MS=5000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_NAME=users_test
DB_SSL=false

# Finance — stubs locais (scripts/finance-dev-stubs.js)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=test
CLICKHOUSE_PASSWORD=test
TRIO_BASE_URL=http://localhost:9001
TRIO_CLIENT_ID=test
TRIO_CLIENT_SECRET=test
TRIO_AMOUNT_DIVISOR=100
TRIO_ACCOUNT_ID_SUPREMA=acc-suprema
TRIO_ACCOUNT_ID_ULTRA=acc-ultra
TRIO_ACCOUNT_ID_MAXIMA=acc-maxima
SAYPLUS_API_URL=http://localhost:3100
