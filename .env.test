# Ambiente de testes unitários (os e2e recebem env dos Testcontainers em runtime).
# Sem credencial real: valores inertes apenas para satisfazer a validação de config.
NODE_ENV=test
API_PREFIX=api/v1
PORT=3001
HTTP_REQUEST_TIMEOUT_MS=5000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_NAME=users_test
DB_SSL=false
